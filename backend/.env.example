# Local development only. Real credentials belong in an ignored .env or host secrets.
OVRLY_DATABASE_URL=postgresql+psycopg://ovrly:local-development-only@127.0.0.1:55432/ovrly
OVRLY_POSTGRES_PASSWORD=local-development-only
OVRLY_POSTGRES_PORT=55432
OVRLY_API_PORT=8000
# The development helper enables the embedded worker; ordinary API startup does not.
OVRLY_EMBED_WORKER=0
# Job engine and worker timing (BE-04).
OVRLY_DATABASE_TIMEOUT_SECONDS=3
OVRLY_WORKER_SHUTDOWN_SECONDS=5
OVRLY_JOB_LEASE_SECONDS=30
OVRLY_JOB_POLL_SECONDS=1
OVRLY_JOB_RETRY_TRANSIENT_ATTEMPTS=5
OVRLY_JOB_RETRY_RATE_LIMITED_ATTEMPTS=5
OVRLY_JOB_RETRY_SCHEMA_REPAIR_ATTEMPTS=2
OVRLY_JOB_RETRY_UNKNOWN_OUTCOME_ATTEMPTS=3
OVRLY_JOB_RETRY_BACKOFF_SECONDS=1
OVRLY_JOB_RETRY_MAX_BACKOFF_SECONDS=60
# Intake limits. The byte limit is a placeholder until BC-D06; duration is BC-D01's 10 minutes.
OVRLY_UPLOAD_MAX_BYTES=268435456
OVRLY_UPLOAD_TARGET_SECONDS=900
OVRLY_MAX_SHARED_DURATION_SECONDS=600
# Local, Git-ignored upload storage relative to backend/; object storage is pending BC-D03.
OVRLY_STORAGE_DIR=.data/uploads
# Private preparation storage, shared by API/worker; requires ffmpeg, ffprobe and prlimit.
OVRLY_ARTIFACTS_DIR=.data/artifacts
OVRLY_FFPROBE_PATH=ffprobe
OVRLY_FFMPEG_PATH=ffmpeg
OVRLY_MEDIA_PROBE_TIMEOUT_SECONDS=10
OVRLY_MEDIA_EXTRACT_TIMEOUT_SECONDS=120
OVRLY_MEDIA_CPU_SECONDS=60
OVRLY_MEDIA_OUTPUT_MAX_BYTES=65536
# Decimal bytes including WAV headers; provisional, not verified provider entitlement.
OVRLY_ASR_AUDIO_MAX_BYTES=25000000
# Hosted speech stays OFF. No model, account entitlement or live call is preapproved.
OVRLY_ASR_ENABLED=0
OVRLY_TEXT_GRACE_SECONDS=60
OVRLY_ASR_RESPONSE_MAX_BYTES=1048576
OVRLY_ASR_TIMEOUT_SECONDS=120
# Before enabling, explicitly set the exact verified byte cap above and ALL of:
# OVRLY_GROQ_API_KEY (secret; never commit)
# OVRLY_GROQ_MODEL (available model explicitly selected by the operator)
# OVRLY_GROQ_ACCOUNT_ID (stable opaque ledger label, shared by every worker for this account)
# OVRLY_ASR_LIMITS_VERIFIED_ON (YYYY-MM-DD; dated entitlement/limit verification)
# OVRLY_ASR_REQUESTS_PER_MINUTE / OVRLY_ASR_REQUESTS_PER_DAY
# OVRLY_ASR_AUDIO_SECONDS_PER_HOUR / OVRLY_ASR_AUDIO_SECONDS_PER_DAY
# OVRLY_ASR_MINIMUM_BILLABLE_SECONDS (verified minimum charged duration per request)
# Google Web client ID that linked ID tokens must be issued for (BC-D07). Not a secret;
# empty leaves POST /v1/principals/link unavailable (503 ACCOUNT_LINK_UNAVAILABLE).
OVRLY_GOOGLE_CLIENT_ID=
# Proposed demo retention only; read docs/decisions/BC-D06-retention.md before enabling.
OVRLY_RETENTION_ENABLED=0
OVRLY_RETENTION_DATA_SECONDS=86400
OVRLY_RETENTION_TOMBSTONE_SECONDS=604800
OVRLY_RETENTION_POLL_SECONDS=60
OVRLY_RETENTION_BATCH_SIZE=100
# DEVELOPMENT ONLY, never for real users: 1 publishes fixture reports after intake.
OVRLY_STUB_REPORTS=0
# Evidence stages (#27). The Scholarxiv key is a server-only secret; set it in an ignored
# .env or host secrets, never here. Any value, even an empty one, registers the stages,
# so leave the line commented out when there is no key.
# OVRLY_SCHOLARXIV_API_KEY=
OVRLY_SCHOLARXIV_BASE_URL=https://www.scholarxiv.com
# Papers and Router share one account limit; at most 1200 per hour.
OVRLY_SCHOLARXIV_REQUESTS_PER_HOUR=1000
# Federated search needs the Go plan or above.
OVRLY_SCHOLARXIV_FEDERATED=0
OVRLY_EVIDENCE_QUERY_ROUTE=auto:cheap
OVRLY_EVIDENCE_RELATION_ROUTE=auto:quality
OVRLY_EVIDENCE_MAX_CLAIMS=20
OVRLY_EVIDENCE_MAX_QUERIES_PER_CLAIM=3
OVRLY_EVIDENCE_RESULTS_PER_QUERY=10
OVRLY_EVIDENCE_MAX_CANDIDATES_PER_CLAIM=20
OVRLY_EVIDENCE_MAX_PASSAGES_PER_CLAIM=4
OVRLY_EVIDENCE_MAX_FULL_TEXT_PER_CLAIM=2
OVRLY_EVIDENCE_MAX_LLM_CALLS_PER_CLAIM=4
OVRLY_EVIDENCE_PROVIDER_TIMEOUT_SECONDS=20
# Optional contact address for the Crossref polite pool.
OVRLY_CROSSREF_MAILTO=
# Proposed admission policy (#22); keep API and worker values identical.
# Groq, Voxide and claim-extraction quota integration remain pending.
OVRLY_QUOTAS_ENABLED=0
OVRLY_QUOTA_ACTIVE_CHECKS=2
OVRLY_QUOTA_DAILY_CHECKS=6
OVRLY_QUOTA_DAILY_UPLOAD_BYTES=268435456
OVRLY_QUOTA_CLAIMS_PER_RUN=5
OVRLY_QUOTA_PROVIDER_CONCURRENCY=2
OVRLY_QUOTA_PROVIDER_RESERVE=50
