{
  "openapi": "3.1.0",
  "info": {
    "title": "Ovrly API",
    "version": "0.2.0-draft",
    "summary": "Contract between the Android client and the backend.",
    "description": "Ovrly contracts 0.2.0-draft (pre-1.0). Shared-media investigation reads derive state from the intake job (queued/leased -> queued, running -> running, failed -> failed with PROCESSING_FAILED, cancelled/deleted -> cancelled). Capture progress uses GET /v1/captures/{capture_id}; media analysis and claim extraction are not implemented yet. Every schema is a reference into schemas/*.schema.json so the OpenAPI document, the JSON Schema fixtures and the Android models cannot drift from each other. Every error response uses the shared error shape; stage-specific error codes are listed per operation and must be SCREAMING_SNAKE_CASE. Paths listed here are those the backend serves today (BE-05, #19, including account linking from BC-D07, the owner-scoped job actions from BE-04 part 3, #75, and incremental capture intake from BE-06, #24) plus POST /v1/voice/actions (BE-13, #67; served by BE-10, #33). Report-version retrieval and reanalysis are #33.",
    "license": {
      "name": "PolyForm Noncommercial 1.0.0",
      "identifier": "PolyForm-Noncommercial-1.0.0"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "Local development helper (scripts/backend.sh). No hosted server is published by this document."
    }
  ],
  "security": [{ "bearer": [] }],
  "tags": [
    { "name": "principals", "description": "Guest identity (BE-05)." },
    { "name": "uploads", "description": "Declared and verified media uploads (BE-05)." },
    { "name": "investigations", "description": "Checks: idempotent creation and owner-scoped reads (BE-05)." },
    { "name": "voice", "description": "Allowlisted voice actions (BE-13 contract, BE-10 endpoint)." },
    { "name": "jobs", "description": "Owner-scoped job cancellation and deletion receipts (BE-04 part 3)." },
    { "name": "captures", "description": "Owner-scoped incremental capture intake, close and polling (BE-06)." }
  ],
  "paths": {
    "/v1/captures": {
      "post": {
        "tags": ["captures"],
        "operationId": "createCapture",
        "summary": "Create a live capture and its investigation.",
        "description": "Requires an owner-scoped Idempotency-Key. Replay returns the original empty session; a different nominal duration under that key conflicts. No media job is created until a verified chunk arrives.",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CaptureCreateRequest" } } }
        },
        "responses": {
          "201": {
            "description": "Created session, or its original acknowledgement on replay.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CaptureSession" } } }
          },
          "400": { "$ref": "#/components/responses/CaptureBadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "409": { "$ref": "#/components/responses/CaptureConflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    },
    "/v1/captures/{capture_id}": {
      "parameters": [{ "$ref": "#/components/parameters/CaptureId" }],
      "get": {
        "tags": ["captures"],
        "operationId": "getCapture",
        "summary": "Poll manifest, chunk work and per-claim progress.",
        "description": "Only verified chunks count toward coverage and gaps. Speech/text coverage is client-declared, not completed analysis. The current processor verifies media bytes only; claims are empty and not_started, never a no-claims finding.",
        "responses": {
          "200": {
            "description": "Consistent owner-scoped capture snapshot.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CaptureStatus" } } }
          },
          "400": { "$ref": "#/components/responses/CaptureBadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    },
    "/v1/captures/{capture_id}/chunks/{seq}": {
      "parameters": [
        { "$ref": "#/components/parameters/CaptureId" },
        { "name": "seq", "in": "path", "required": true, "description": "Zero-based chunk sequence.", "schema": { "type": "integer", "minimum": 0 } }
      ],
      "put": {
        "tags": ["captures"],
        "operationId": "putCaptureChunk",
        "summary": "Verify and durably enqueue a capture chunk without waiting for close.",
        "description": "Exactly one metadata text part (UTF-8 JSON CaptureMetadata) and one content file part. Intervals follow the session chunk duration and cannot exceed 180000ms; only the final chunk may be shorter. Identical metadata and bytes replay the original received_at with disposition duplicate and CURRENT gaps, even after close/expiry. Changed metadata or bytes conflicts. The session-wide byte budget includes pending reservations. Authorization precedes multipart parsing; metadata and multipart overhead are bounded. New bytes must finish before expires_at.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["metadata", "content"],
                "properties": {
                  "metadata": { "$ref": "#/components/schemas/CaptureMetadata" },
                  "content": { "type": "string", "format": "binary" }
                }
              },
              "encoding": { "metadata": { "contentType": "application/json" }, "content": { "contentType": "application/octet-stream" } }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored, out-of-order or duplicate acknowledgement.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CaptureChunk" } } }
          },
          "400": { "$ref": "#/components/responses/CaptureBadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/CaptureConflict" },
          "410": {
            "description": "CAPTURE_EXPIRED: upload window ended; identical stored retries and close remain available.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "413": {
            "description": "CAPTURE_TOO_LARGE: body or session exceeds the configured upload byte budget.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    },
    "/v1/captures/{capture_id}/close": {
      "parameters": [{ "$ref": "#/components/parameters/CaptureId" }],
      "post": {
        "tags": ["captures"],
        "operationId": "closeCapture",
        "summary": "Stop intake and record whether research should continue.",
        "description": "Close and chunk commits serialize on the session. False requests cancellation of accepted chunk jobs in the same transaction; already-published work is retained. True preserves queued work. Replays are stable; changed effective duration/choice conflicts. Close is allowed after expiry.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CaptureCloseRequest" } } }
        },
        "responses": {
          "200": {
            "description": "Closed session acknowledgement.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CaptureSession" } } }
          },
          "400": { "$ref": "#/components/responses/CaptureBadRequest" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/CaptureConflict" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    },
    "/v1/principals/guest": {
      "post": {
        "tags": ["principals"],
        "operationId": "createGuestPrincipal",
        "summary": "Mint a guest principal and an opaque bearer credential.",
        "description": "The only operation that needs no credential. The token is returned once and never logged; only its digest is stored.",
        "security": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GuestPrincipalRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Principal created.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GuestPrincipalResponse" }
              }
            }
          },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    },
    "/v1/principals/link": {
      "post": {
        "tags": ["principals"],
        "operationId": "linkAccount",
        "summary": "Link the calling guest to a Google account, or continue as that account on a second device.",
        "description": "BE-05 part 2, BC-D07. The server verifies the provider ID token itself; the client never sends a user_id. A first link upgrades the calling principal in place. A second device merges into the existing account in one transaction and receives a fresh credential for it; every write is restricted to the calling principal.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AccountLinkRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Linked. credential is present only when the device continues as an existing account.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AccountLinkResponse" }
              }
            }
          },
          "401": {
            "description": "AUTHENTICATION_REQUIRED or INVALID_CREDENTIAL (bearer), or INVALID_ID_TOKEN (the provider token could not be verified; action authenticate).",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" },
              "WWW-Authenticate": { "schema": { "type": "string" } }
            },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": {
            "description": "ACCOUNT_LINK_UNAVAILABLE (linking is not configured on this server) or DATABASE_UNAVAILABLE.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      }
    },
    "/v1/uploads": {
      "post": {
        "tags": ["uploads"],
        "operationId": "declareUpload",
        "summary": "Declare the bytes about to be uploaded and receive a scoped target.",
        "description": "Declares size_bytes, sha256 and an optional content_type. The server answers with a scoped target path, the byte limit in force and an expiry; bytes are verified against the declaration at completion.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UploadDeclareRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Upload declared; state pending.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UploadDeclareResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "413": {
            "description": "UPLOAD_TOO_LARGE: size_bytes exceeds OVRLY_UPLOAD_MAX_BYTES.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    },
    "/v1/uploads/{upload_id}/content": {
      "parameters": [{ "$ref": "#/components/parameters/UploadId" }],
      "put": {
        "tags": ["uploads"],
        "operationId": "putUploadContent",
        "summary": "Stream the raw bytes to the declared target.",
        "description": "The upload row lock is held while bytes stream. Exceeding the smaller of the declared size and the limit discards the partial content.",
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": { "type": "string", "contentMediaType": "application/octet-stream" }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Bytes stored; not yet verified.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "UPLOAD_ALREADY_COMPLETED: the upload was already verified.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "410": {
            "description": "UPLOAD_EXPIRED: the target no longer accepts bytes; declare again.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "413": {
            "description": "UPLOAD_TOO_LARGE: more bytes than declared or allowed; partial content discarded.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    },
    "/v1/uploads/{upload_id}/complete": {
      "parameters": [{ "$ref": "#/components/parameters/UploadId" }],
      "post": {
        "tags": ["uploads"],
        "operationId": "completeUpload",
        "summary": "Verify the stored bytes against the declaration.",
        "description": "Idempotent: completing twice returns the same 200.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UploadCompleteRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Upload verified; state completed.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UploadCompleteResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "UPLOAD_MISMATCH (bytes deleted; upload again), UPLOAD_CONTENT_MISSING (nothing was uploaded) or UPLOAD_ALREADY_COMPLETED.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "410": {
            "description": "UPLOAD_EXPIRED.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    },
    "/v1/investigations": {
      "post": {
        "tags": ["investigations"],
        "operationId": "createInvestigation",
        "summary": "Record an investigation durably, then answer 202.",
        "description": "Requires Idempotency-Key. The same key with the same body replays the original 202; the same key with a different body is 409 IDEMPOTENCY_KEY_REUSED. Keys are scoped per owner.",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InvestigationCreateRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Investigation recorded at stage intake with processing_status waiting.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Investigation" } }
            }
          },
          "400": {
            "description": "IDEMPOTENCY_KEY_REQUIRED or IDEMPOTENCY_KEY_INVALID (longer than 200 characters).",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "IDEMPOTENCY_KEY_REUSED (different body) or UPLOAD_INCOMPLETE (the upload is not completed).",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "422": {
            "description": "VALIDATION_FAILED, CLIENT_IDENTITY_REJECTED or DURATION_LIMIT_EXCEEDED.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      },
      "get": {
        "tags": ["investigations"],
        "operationId": "listInvestigations",
        "summary": "List the caller's investigations, newest first, at most 100.",
        "description": "Owner-scoped: only the caller's investigations are visible. Each item is the same read model as GET /v1/investigations/{investigation_id}.",
        "responses": {
          "200": {
            "description": "Owner-scoped list.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InvestigationList" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    },
    "/v1/jobs/{job_id}/cancel": {
      "parameters": [{ "$ref": "#/components/parameters/JobId" }],
      "post": {
        "tags": ["jobs"],
        "operationId": "cancelJob",
        "summary": "Cancel one owned job: effective now or requested from its worker.",
        "description": "No request body; a body is rejected with VALIDATION_FAILED. A queued or already cancelled job answers 200 with cancellation effective; a leased or running job answers 202 with cancellation requested and the worker makes it effective. The first outcome is stored and replayed unchanged on repeats, even after the worker acknowledges or the API restarts: this is a receipt, not a progress snapshot, and it promises nothing about provider interruption or billing. Missing, other-owner and legacy ownerless jobs all answer the same 404.",
        "responses": {
          "200": {
            "description": "Cancellation effective.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JobCancelResponse" }
              }
            }
          },
          "202": {
            "description": "Cancellation requested; the worker observes it at its next heartbeat or lease expiry.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JobCancelResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ClientIdentityRejected" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "JOB_NOT_CANCELLABLE: the job is already published or failed.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    },
    "/v1/jobs/{job_id}": {
      "parameters": [{ "$ref": "#/components/parameters/JobId" }],
      "delete": {
        "tags": ["jobs"],
        "operationId": "deleteJob",
        "summary": "Tombstone one owned job and clear its database payload and result.",
        "description": "No request body; a body is rejected with VALIDATION_FAILED. Deletion revokes access, fences late worker publication and removes the job payload and published result in one transaction; the tombstone keeps ownership, fencing and provider-request metadata so a late callback is routed to nothing. cleanup_scope is job_payload_and_result only: uploads, provider copies, external artifacts and backups are not covered (#77). Repeating DELETE returns the same receipt without another mutation; a cancellation receipt is no longer readable after deletion (404).",
        "responses": {
          "200": {
            "description": "Job tombstoned; cleanup of the database payload and result complete.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/JobDeleteResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ClientIdentityRejected" },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    },
    "/v1/investigations/{investigation_id}": {
      "parameters": [{ "$ref": "#/components/parameters/InvestigationId" }],
      "get": {
        "tags": ["investigations"],
        "operationId": "getInvestigation",
        "summary": "Read one investigation.",
        "description": "Another owner's investigation is a plain 404; existence is not revealed. The six result fixtures under fixtures/results are payloads of this response.",
        "responses": {
          "200": {
            "description": "Investigation read model.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Investigation" } }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    },
    "/v1/voice/actions": {
      "post": {
        "tags": ["voice"],
        "operationId": "executeVoiceAction",
        "summary": "Execute one allowlisted voice action against one owned target.",
        "description": "Contract fixed by BE-13 (#67); the endpoint is BE-10 (#33). A body that fails schema validation is rejected by the framework with the shared error shape before a handler runs. In-contract denials answer 200 with result denied and one of the four voice error codes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VoiceActionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted or denied; see result.",
            "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/VoiceActionResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthenticated" },
          "422": { "$ref": "#/components/responses/ValidationFailed" },
          "500": { "$ref": "#/components/responses/InternalError" },
          "503": { "$ref": "#/components/responses/DatabaseUnavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque token minted by POST /v1/principals/guest (ovk_ prefix). Identity comes only from this credential; a user_id, owner_id or principal_id in a body, query or header is rejected with CLIENT_IDENTITY_REJECTED."
      }
    },
    "headers": {
      "X-Request-Id": {
        "description": "Echoed from a well-formed client X-Request-Id (opaque_id syntax) or generated. Equals error.request_id on every error response.",
        "schema": { "$ref": "schemas/common.schema.json#/$defs/opaque_id" }
      }
    },
    "parameters": {
      "CaptureId": {
        "name": "capture_id", "in": "path", "required": true,
        "schema": { "$ref": "schemas/common.schema.json#/$defs/uuid" }
      },
      "UploadId": {
        "name": "upload_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "schemas/common.schema.json#/$defs/uuid" }
      },
      "InvestigationId": {
        "name": "investigation_id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "schemas/common.schema.json#/$defs/uuid" }
      },
      "JobId": {
        "name": "job_id",
        "in": "path",
        "required": true,
        "description": "Canonical lowercase UUID of the job, as the queue stores it. The path parameters of both job actions are described by schemas/job-action-request.schema.json; neither operation takes a body.",
        "schema": { "$ref": "schemas/job-action-request.schema.json#/properties/job_id" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Client-chosen key, at most 200 characters after trimming, scoped to the caller.",
        "schema": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "responses": {
      "CaptureBadRequest": {
        "description": "IDEMPOTENCY_KEY_REQUIRED, IDEMPOTENCY_KEY_INVALID or CLIENT_IDENTITY_REJECTED.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "CaptureConflict": {
        "description": "IDEMPOTENCY_KEY_REUSED, CAPTURE_CHUNK_CONFLICT, CAPTURE_CLOSED, CAPTURE_FINAL_CHUNK or CAPTURE_CLOSE_CONFLICT. The supplied request conflicts with durable capture state.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unauthenticated": {
        "description": "AUTHENTICATION_REQUIRED (no credential) or INVALID_CREDENTIAL (malformed, unknown or revoked), with WWW-Authenticate.",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" },
          "WWW-Authenticate": { "schema": { "type": "string" } }
        },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "NOT_FOUND: no such object visible to the caller. Another owner's object answers the same way.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "ValidationFailed": {
        "description": "VALIDATION_FAILED (body, query or path invalid) or CLIENT_IDENTITY_REJECTED.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "ClientIdentityRejected": {
        "description": "CLIENT_IDENTITY_REJECTED: a user_id, owner_id or principal_id arrived in the query string or an X-User-Id style header; identity comes only from the bearer credential.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "InternalError": {
        "description": "INTERNAL_ERROR: unexpected failure; no internals are revealed.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "DatabaseUnavailable": {
        "description": "DATABASE_UNAVAILABLE: retryable; action retry.",
        "headers": { "X-Request-Id": { "$ref": "#/components/headers/X-Request-Id" } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "CaptureCreateRequest": { "$ref": "schemas/capture-create-request.schema.json" },
      "CaptureCloseRequest": { "$ref": "schemas/capture-close-request.schema.json" },
      "CaptureMetadata": { "$ref": "schemas/capture-metadata.schema.json" },
      "CaptureStatus": { "$ref": "schemas/capture-status.schema.json" },
      "GuestPrincipalRequest": {
        "type": "object",
        "description": "Empty body; mirrors services/api/schemas.py GuestPrincipalRequest.",
        "additionalProperties": false,
        "properties": {}
      },
      "GuestPrincipalResponse": {
        "type": "object",
        "description": "Mirrors services/api/schemas.py GuestPrincipalResponse. The token appears here once.",
        "additionalProperties": false,
        "required": ["principal_id", "kind", "credential"],
        "properties": {
          "principal_id": { "$ref": "schemas/common.schema.json#/$defs/uuid" },
          "kind": { "type": "string", "enum": ["guest"] },
          "credential": {
            "type": "object",
            "additionalProperties": false,
            "required": ["token", "token_type"],
            "properties": {
              "token": { "type": "string", "minLength": 1, "maxLength": 256 },
              "token_type": { "type": "string", "enum": ["bearer"] }
            }
          }
        }
      },
      "AccountLinkRequest": {
        "type": "object",
        "description": "Mirrors services/api/schemas.py AccountLinkRequest. The ID token is verified server-side.",
        "additionalProperties": false,
        "required": ["provider", "id_token"],
        "properties": {
          "provider": { "type": "string", "enum": ["google"] },
          "id_token": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      },
      "AccountLinkResponse": {
        "type": "object",
        "description": "Mirrors services/api/schemas.py AccountLinkResponse. credential is null when the calling principal was upgraded in place.",
        "additionalProperties": false,
        "required": ["principal_id", "kind", "linked", "merged_saved_reports", "credential"],
        "properties": {
          "principal_id": { "$ref": "schemas/common.schema.json#/$defs/uuid" },
          "kind": { "type": "string", "enum": ["account"] },
          "linked": { "type": "boolean", "const": true },
          "merged_saved_reports": { "type": "integer" },
          "credential": {
            "oneOf": [
              { "type": "null" },
              { "$ref": "#/components/schemas/GuestPrincipalResponse/properties/credential" }
            ]
          }
        }
      },
      "InvestigationList": {
        "type": "object",
        "description": "Mirrors services/api/schemas.py InvestigationListResponse.",
        "additionalProperties": false,
        "required": ["items"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Investigation" } }
        }
      },
      "Error": { "$ref": "schemas/error.schema.json" },
      "Upload": { "$ref": "schemas/upload.schema.json" },
      "UploadDeclareRequest": { "$ref": "schemas/upload-declare-request.schema.json" },
      "UploadDeclareResponse": { "$ref": "schemas/upload-declare-response.schema.json" },
      "UploadCompleteRequest": { "$ref": "schemas/upload-complete-request.schema.json" },
      "UploadCompleteResponse": { "$ref": "schemas/upload-complete-response.schema.json" },
      "InvestigationCreateRequest": { "$ref": "schemas/investigation-create-request.schema.json" },
      "Investigation": { "$ref": "schemas/investigation.schema.json" },
      "Job": { "$ref": "schemas/job.schema.json" },
      "ReportVersion": { "$ref": "schemas/report-version.schema.json" },
      "Claim": { "$ref": "schemas/claim.schema.json" },
      "Evidence": { "$ref": "schemas/evidence.schema.json" },
      "Assessment": { "$ref": "schemas/assessment.schema.json" },
      "CaptureSession": { "$ref": "schemas/capture-session.schema.json" },
      "CaptureChunkRequest": { "$ref": "schemas/capture-chunk-request.schema.json" },
      "CaptureChunk": { "$ref": "schemas/capture-chunk.schema.json" },
      "VoiceActionRequest": { "$ref": "schemas/voice-action-request.schema.json" },
      "VoiceActionResponse": { "$ref": "schemas/voice-action-response.schema.json" },
      "JobCancelResponse": { "$ref": "schemas/job-cancel-response.schema.json" },
      "JobDeleteResponse": { "$ref": "schemas/job-delete-response.schema.json" }
    }
  }
}
