{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Ovrly contracts 0.2.0-draft. Generated by device_text.py; backend-only v1.",
  "title": "Completed-upload device text",
  "description": "Synthetic-tested backend handoff, not the Android live-capture chunk wire format. Completion records delivery, not continuous coverage or successful OCR. Cross-field identity, timestamp, region-outcome and source-budget checks are also enforced by the server; see README.",
  "$defs": {
    "DeviceTextRead": {
      "properties": {
        "protocol_version": {
          "const": 1,
          "default": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "investigation_id": {
          "title": "Investigation Id",
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "upload_id": {
          "title": "Upload Id",
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "timebase": {
          "const": "media",
          "default": "media",
          "title": "Timebase",
          "type": "string"
        },
        "status": {
          "enum": [
            "not_started",
            "receiving",
            "completed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "job_id": {
          "title": "Job Id",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "batches": {
          "items": {
            "$ref": "#/$defs/TextBatchRead"
          },
          "title": "Batches",
          "type": "array"
        },
        "completion": {
          "oneOf": [
            {
              "$ref": "#/$defs/TextCompletion"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "investigation_id",
        "upload_id",
        "source_sha256",
        "status",
        "job_id",
        "batches",
        "completion"
      ],
      "title": "DeviceTextRead",
      "type": "object",
      "additionalProperties": false
    },
    "TextBatch": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "upload_id": {
          "title": "Upload Id",
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "timebase": {
          "const": "media",
          "title": "Timebase",
          "type": "string"
        },
        "rotation_degrees": {
          "const": 0,
          "title": "Rotation Degrees",
          "type": "integer"
        },
        "box_space": {
          "const": "normalized_10000",
          "title": "Box Space",
          "type": "string"
        },
        "recognizer": {
          "default": null,
          "oneOf": [
            {
              "$ref": "#/$defs/TextRecognizer"
            },
            {
              "type": "null"
            }
          ]
        },
        "sampling": {
          "default": null,
          "oneOf": [
            {
              "$ref": "#/$defs/TextSampling"
            },
            {
              "type": "null"
            }
          ]
        },
        "frames": {
          "items": {
            "$ref": "#/$defs/TextFrame"
          },
          "maxItems": 100,
          "title": "Frames",
          "type": "array"
        }
      },
      "required": [
        "protocol_version",
        "upload_id",
        "source_sha256",
        "timebase",
        "rotation_degrees",
        "box_space",
        "frames"
      ],
      "title": "TextBatch",
      "type": "object"
    },
    "TextBatchRead": {
      "additionalProperties": false,
      "properties": {
        "batch_id": {
          "maximum": 63,
          "minimum": 0,
          "title": "Batch Id",
          "type": "integer"
        },
        "body": {
          "$ref": "#/$defs/TextBatch"
        }
      },
      "required": [
        "batch_id",
        "body"
      ],
      "title": "TextBatchRead",
      "type": "object"
    },
    "TextCompletion": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 1,
          "title": "Protocol Version",
          "type": "integer"
        },
        "upload_id": {
          "title": "Upload Id",
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "source_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Sha256",
          "type": "string"
        },
        "timebase": {
          "const": "media",
          "title": "Timebase",
          "type": "string"
        },
        "rotation_degrees": {
          "const": 0,
          "title": "Rotation Degrees",
          "type": "integer"
        },
        "box_space": {
          "const": "normalized_10000",
          "title": "Box Space",
          "type": "string"
        },
        "recognizer": {
          "default": null,
          "oneOf": [
            {
              "$ref": "#/$defs/TextRecognizer"
            },
            {
              "type": "null"
            }
          ]
        },
        "sampling": {
          "default": null,
          "oneOf": [
            {
              "$ref": "#/$defs/TextSampling"
            },
            {
              "type": "null"
            }
          ]
        },
        "batch_count": {
          "maximum": 64,
          "minimum": 0,
          "title": "Batch Count",
          "type": "integer"
        },
        "dropped_frames": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Dropped Frames",
          "type": "integer"
        },
        "capped_frames": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Capped Frames",
          "type": "integer"
        },
        "unfinished_frames": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Unfinished Frames",
          "type": "integer"
        }
      },
      "required": [
        "protocol_version",
        "upload_id",
        "source_sha256",
        "timebase",
        "rotation_degrees",
        "box_space",
        "batch_count",
        "dropped_frames",
        "capped_frames",
        "unfinished_frames"
      ],
      "title": "TextCompletion",
      "type": "object"
    },
    "TextFrame": {
      "additionalProperties": false,
      "properties": {
        "frame_pts": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Frame Pts",
          "type": "integer"
        },
        "status": {
          "enum": [
            "recognized",
            "no_text_regions",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "regions": {
          "maximum": 100,
          "minimum": 0,
          "title": "Regions",
          "type": "integer"
        },
        "recognition_ms": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Recognition Ms",
          "type": "integer"
        },
        "failed_regions": {
          "maximum": 100,
          "minimum": 0,
          "title": "Failed Regions",
          "type": "integer"
        },
        "text_observations": {
          "items": {
            "$ref": "#/$defs/TextObservation"
          },
          "maxItems": 100,
          "title": "Text Observations",
          "type": "array"
        }
      },
      "required": [
        "frame_pts",
        "status",
        "regions",
        "recognition_ms",
        "failed_regions",
        "text_observations"
      ],
      "title": "TextFrame",
      "type": "object"
    },
    "TextObservation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "text": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "box": {
          "items": {
            "maximum": 10000,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Box",
          "type": "array"
        },
        "frame_pts": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Frame Pts",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "text",
        "box",
        "frame_pts"
      ],
      "title": "TextObservation",
      "type": "object"
    },
    "TextRecognizer": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "TextRecognizer",
      "type": "object"
    },
    "TextSampling": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "const": "change_triggered",
          "title": "Policy",
          "type": "string"
        },
        "probe_interval_ms": {
          "maximum": 60000,
          "minimum": 1,
          "title": "Probe Interval Ms",
          "type": "integer"
        },
        "thumbnail_edge": {
          "maximum": 1024,
          "minimum": 1,
          "title": "Thumbnail Edge",
          "type": "integer"
        },
        "change_threshold": {
          "maximum": 255,
          "minimum": 0,
          "title": "Change Threshold",
          "type": "integer"
        },
        "heartbeat_ms": {
          "maximum": 600000,
          "minimum": 1,
          "title": "Heartbeat Ms",
          "type": "integer"
        },
        "max_frames_per_minute": {
          "maximum": 6000,
          "minimum": 1,
          "title": "Max Frames Per Minute",
          "type": "integer"
        },
        "frame_long_edge": {
          "maximum": 8192,
          "minimum": 1,
          "title": "Frame Long Edge",
          "type": "integer"
        }
      },
      "required": [
        "policy",
        "probe_interval_ms",
        "thumbnail_edge",
        "change_threshold",
        "heartbeat_ms",
        "max_frames_per_minute",
        "frame_long_edge"
      ],
      "title": "TextSampling",
      "type": "object"
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/TextBatch"
    },
    {
      "$ref": "#/$defs/TextCompletion"
    },
    {
      "$ref": "#/$defs/DeviceTextRead"
    }
  ]
}
