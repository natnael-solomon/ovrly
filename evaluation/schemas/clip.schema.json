{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evaluation clip v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "clip_id", "synthetic", "language", "style", "duration_ms", "provider", "source_url", "creator_ids", "topic_ids", "repost_group_id", "split", "rights", "media", "coverage"],
  "properties": {
    "schema_version": {"const": 1},
    "clip_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"},
    "synthetic": {"type": "boolean"},
    "language": {"const": "en"},
    "style": {"enum": ["live", "shared"]},
    "duration_ms": {"type": "integer", "minimum": 1, "maximum": 600000},
    "provider": {"type": "string", "minLength": 1},
    "source_url": {"type": ["string", "null"], "pattern": "^https://[^\\s]+$"},
    "creator_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"}},
    "topic_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"}},
    "repost_group_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"},
    "split": {"enum": ["dev", "test"]},
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "reference", "attribution", "allows_redistribution"],
      "properties": {
        "basis": {"enum": ["synthetic", "consent", "license", "public-domain"]},
        "reference": {"type": "string", "minLength": 1},
        "attribution": {"type": "string", "minLength": 1},
        "allows_redistribution": {"type": "boolean"}
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": ["string", "null"], "minLength": 1},
        "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "coverage": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["speech-only", "text-only", "brief-title-card", "negation", "later-self-correction", "quoted-misinformation", "mixed-evidence", "missing-context", "withdrawn-retracted-source", "no-assessable-claims", "normative-factual-premises"]}
    }
  }
}
