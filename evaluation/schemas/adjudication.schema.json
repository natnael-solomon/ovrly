{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single-pass whole-clip adjudication v2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "adjudication_id", "clip_id", "synthetic", "adjudicator_id", "adjudicator_kind", "annotation_ids", "review_note", "decisions"],
  "properties": {
    "schema_version": {"const": 2},
    "adjudication_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"},
    "clip_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"},
    "synthetic": {"type": "boolean"},
    "adjudicator_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"},
    "adjudicator_kind": {"enum": ["human", "ai-assisted"]},
    "review_status": {"enum": ["provisional", "complete"]},
    "annotation_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"}},
    "review_note": {"type": "string", "minLength": 1},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["gold_id", "proposition_id", "references", "start_ms", "end_ms", "modality", "eligible", "proposition", "reason", "resolution"],
        "properties": {
          "gold_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"},
          "proposition_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"},
          "references": {
            "type": "array", "uniqueItems": true,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["annotation_id", "occurrence_id"],
              "properties": {
                "annotation_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"},
                "occurrence_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"}
              }
            }
          },
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 1},
          "modality": {"enum": ["speech", "on-screen-text", "both", "unverified"]},
          "timing_basis": {"enum": ["caption-envelope", "user-segment", "subtitle-cue", "user-card-interval", "media-reviewed"]},
          "eligible": {"type": "boolean"},
          "proposition": {"type": "string", "minLength": 1},
          "reason": {"enum": ["factual-claim", "factual-premise", "opinion", "quoted-not-endorsed", "insufficient-context", "not-a-claim"]},
          "resolution": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
