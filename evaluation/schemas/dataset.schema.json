{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evaluation snapshot v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "dataset_version", "kind", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "kind": {"enum": ["examples", "frozen"]},
    "files": {
      "type": "object", "additionalProperties": false,
      "required": ["clips.jsonl", "annotations.jsonl", "adjudications.jsonl"],
      "properties": {
        "clips.jsonl": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "annotations.jsonl": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "adjudications.jsonl": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
